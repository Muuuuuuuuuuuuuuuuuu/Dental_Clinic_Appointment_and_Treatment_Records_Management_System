{
  // ==============================================================================
  // ไฟล์ตั้งค่าภาษา TypeScript (tsconfig.json)
  // หน้าที่: กำหนดกฎและรูปแบบการแปลงโค้ดภาษา TypeScript (.ts, .tsx) ทั้งหมดในโฟลเดอร์ src
  // ==============================================================================
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
