# ==============================================================================
# ไฟล์ตั้งค่า Node Package Manager (.npmrc)
# หน้าที่: กำหนดพฤติกรรมเวลาติดตั้งแพ็กเกจ (npm install)
# ประโยชน์:
#   - legacy-peer-deps=true : ช่วยให้ติดตั้งไลบรารีต่างๆ ได้อย่างราบรื่น ไม่ติดปัญหา
#     เวอร์ชันขัดแย้งกันของแพ็กเกจย่อย (โดยเฉพาะเวลา Vercel สั่ง build บน Cloud)
# ==============================================================================

legacy-peer-deps=true
